{
  "name": "hedron",
  "version": "0.2.0-alpha.0",
  "description": "Hedera-native agentic commerce SDK and Router/Broker runtime for autonomous agents.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./types": {
      "import": "./dist/src/types/index.js",
      "require": "./dist/src/types/index.js",
      "types": "./dist/src/types/index.d.ts"
    },
    "./router": {
      "import": "./dist/src/router/index.js",
      "require": "./dist/src/router/index.js",
      "types": "./dist/src/router/index.d.ts"
    },
    "./broker": {
      "import": "./dist/src/broker/index.js",
      "require": "./dist/src/broker/index.js",
      "types": "./dist/src/broker/index.d.ts"
    },
    "./registry": {
      "import": "./dist/src/registry/index.js",
      "require": "./dist/src/registry/index.js",
      "types": "./dist/src/registry/index.d.ts"
    },
    "./policy": {
      "import": "./dist/src/policy/index.js",
      "require": "./dist/src/policy/index.js",
      "types": "./dist/src/policy/index.d.ts"
    },
    "./settlement": {
      "import": "./dist/src/settlement/index.js",
      "require": "./dist/src/settlement/index.js",
      "types": "./dist/src/settlement/index.d.ts"
    },
    "./hcs": {
      "import": "./dist/src/hcs/index.js",
      "require": "./dist/src/hcs/index.js",
      "types": "./dist/src/hcs/index.d.ts"
    },
    "./receipts": {
      "import": "./dist/src/receipts/index.js",
      "require": "./dist/src/receipts/index.js",
      "types": "./dist/src/receipts/index.d.ts"
    },
    "./adapters/daydreams": {
      "import": "./dist/src/adapters/daydreams/index.js",
      "require": "./dist/src/adapters/daydreams/index.js",
      "types": "./dist/src/adapters/daydreams/index.d.ts"
    },
    "./adapters/hedera-agent-kit": {
      "import": "./dist/src/adapters/hedera-agent-kit/index.js",
      "require": "./dist/src/adapters/hedera-agent-kit/index.js",
      "types": "./dist/src/adapters/hedera-agent-kit/index.d.ts"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "hedera",
    "hashgraph",
    "agentic-commerce",
    "router",
    "broker",
    "hcs",
    "x402",
    "payai",
    "daydreams",
    "hedera-agent-kit",
    "agent",
    "autonomous-agents",
    "a2a-protocol",
    "ap2",
    "hcs-10",
    "policy",
    "receipts"
  ],
  "scripts": {
    "clean": "rimraf dist build coverage artifacts cache",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "echo 'integration tests are opt-in; set RUN_HEDERA_INTEGRATION=true and run the targeted scripts under tests/integration/' && exit 0",
    "compile:contracts": "echo 'hardhat v3 requires ESM; deferred to v0.2 ESM migration. See docs/ROADMAP.md.'",
    "test:contracts": "echo 'hardhat v3 requires ESM; deferred to v0.2 ESM migration.'",
    "demo": "npm run demo:local",
    "demo:local": "tsx demo/local.ts",
    "demo:testnet": "tsx demo/testnet.ts",
    "demo:invoice-llm": "tsx demo/intelligent-invoice-demo.ts",
    "demo:nft-royalty": "tsx demo/nft-royalty-x402-demo.ts",
    "demo:hbar-x402": "tsx demo/hbar-direct-x402-demo.ts",
    "deploy:supply-chain": "tsx scripts/deploy-supply-chain.ts",
    "deploy:real": "tsx scripts/deploy-real.ts",
    "deploy:simple": "tsx scripts/deploy-simple.ts",
    "setup:agents": "tsx setup/register-agents.ts",
    "check:credentials": "tsx scripts/maintenance/check-credentials-status.ts",
    "check:wallets": "tsx scripts/maintenance/check-wallet-status.ts",
    "secrets:scan": "gitleaks detect --source . --no-git --redact"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glorian-Labs/Hedron.git"
  },
  "author": "Glorian Labs",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Glorian-Labs/Hedron/issues"
  },
  "homepage": "https://github.com/Glorian-Labs/Hedron#readme",
  "dependencies": {
    "@hashgraph/sdk": "^2.75.0",
    "@hashgraphonline/standards-agent-kit": "^0.2.164",
    "@langchain/core": "^1.0.1",
    "@langchain/ollama": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "a2a-x402": "^0.0.5",
    "axios": "^1.12.2",
    "chalk": "^5.6.2",
    "dotenv": "^16.6.1",
    "ethers": "^6.15.0",
    "hedera-agent-kit": "^3.4.0",
    "langchain": "^1.0.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-verify": "^3.0.4",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/axios": "^0.9.36",
    "@types/express": "^5.0.4",
    "@types/node": "^24.9.1",
    "eslint": "^9.38.0",
    "hardhat": "^3.0.9",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
